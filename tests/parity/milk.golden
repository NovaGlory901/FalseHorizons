{"text":"MILKDROP_PRESET_VERSION=201\r\nPSVERSION=2\r\nPSVERSION_WARP=2\r\nPSVERSION_COMP=2\r\n[preset00]\r\nfRating=3.000000\r\nfGammaAdj=1.500000\r\nfDecay=0.960000\r\nfVideoEchoZoom=1.800000\r\nfVideoEchoAlpha=0.300000\r\nnVideoEchoOrientation=3\r\nnWaveMode=4\r\nbAdditiveWaves=1\r\nbWaveThick=1\r\nfWaveAlpha=0.900000\r\nfWaveScale=1.500000\r\nfWarpScale=1.0\r\nzoom=1.010000\r\nrot=0.000000\r\ncx=0.500000\r\ncy=0.500000\r\ndx=0.000000\r\ndy=0.000000\r\nwarp=0.500000\r\nsx=1.000000\r\nsy=1.000000\r\nwave_r=0.200000\r\nwave_g=0.800000\r\nwave_b=1.000000\r\nwave_x=0.500000\r\nwave_y=0.500000\r\nper_frame_init_1=q8 = 0.5;\r\nper_frame_1=// pulse on the bass\r\nper_frame_2=zoom = 1 + 0.02*max(bass-1, 0); /* a comment */\r\nper_frame_3=rot = 0.01*sin(time*0.3);\r\nper_frame_4=q1 = bass_att; wave_r = 0.5 + 0.5*sin(time);\r\nper_pixel_1=zoom = zoom + 0.01*rad*q1;\r\nper_pixel_2=rot = rot + 0.02*sin(ang*3);\r\nwavecode_0_enabled=1\r\nwavecode_0_samples=200\r\nwavecode_0_bSpectrum=1\r\nwavecode_0_bUseDots=1\r\nwavecode_0_bDrawThick=1\r\nwavecode_0_bAdditive=1\r\nwavecode_0_r=0.1\r\nwavecode_0_g=0.9\r\nwavecode_0_b=0.5\r\nwavecode_0_a=0.8\r\nwave_0_init1=t1 = 3;\r\nwave_0_per_frame1=r = 0.5 + 0.5*sin(time + t1);\r\nwave_0_per_point1=x = sample; y = 0.3 + value1 * 0.5;\r\nwavecode_1_enabled=1\r\nwavecode_2_enabled=1\r\nwavecode_3_enabled=1\r\nshapecode_0_enabled=1\r\nshapecode_0_sides=6\r\nshapecode_0_additive=1\r\nshapecode_0_num_inst=5\r\nshapecode_0_textured=1\r\nshapecode_0_x=0.5\r\nshapecode_0_y=0.5\r\nshapecode_0_rad=0.1\r\nshapecode_0_r=1\r\nshapecode_0_g=0.5\r\nshapecode_0_b=0\r\nshapecode_0_a=1\r\nshape_0_init1=q3 = 2;\r\nshape_0_per_frame1=x = 0.5 + 0.3*cos(instance * 1.256 + time); y = 0.5 + 0.3*sin(instance * 1.256 + time);\r\nshapecode_1_enabled=1\r\nshapecode_2_enabled=1\r\nshapecode_3_enabled=1\r\nshapecode_4_enabled=1\r\nwarp_1=`shader_body`\r\nwarp_2={\r\ncomp_1=`shader_body`\r\n","name":"a.b.c.milk","r":{"ok":true,"preset":{"name":"a.b.c","author":"imported