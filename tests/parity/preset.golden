T "{\n \"fh-preset\": 1,\n \"name\": \"Cut-up Tape\",\n \"author\": \"FalseHorizons\",\n \"dialect\": \"fh\",\n \"hear\": 1,\n \"zoom\": 1.002,\n \"rot\": 0,\n \"cx\": 0.5,\n \"cy\": 0.5,\n \"dx\": 0,\n \"dy\": 0,\n \"sx\": 1,\n \"sy\": 1,\n \"warp\": 0.4,\n \"decay\": 0.975,\n \"wave\": {\n  \"mode\": 3,\n  \"r\": 1,\n  \"g\": 1,\n  \"b\": 1,\n  \"a\": 0.5,\n  \"scale\": 0.7,\n  \"x\": 0.5,\n  \"y\": 0.5,\n  \"additive\": true,\n  \"thick\": 1\n },\n \"color\": {\n  \"gamma\": 1,\n  \"hue\": 0,\n  \"bright\": 1,\n  \"solarize\": 0,\n  \"echoAlpha\": 0,\n  \"echoZoom\": 1,\n  \"echoOrient\": 0,\n  \"cover\": 0.6\n },\n \"init\": \"\",\n \"frame\": \"bc = bc + above(beat, 0.98); q1 = bc * 13.7; q2 = 0.006 + 0.05 * bass; hue = 0.003 * time\",\n \"pixel\": \"h1 = frac(sin(floor(x * 16) * 127.1 + floor(y * 9) * 311.7 + q1) * 43758.5); h2 = frac(sin(floor(x * 16) * 269.5 + floor(y * 9) * 183.3 + q1) * 43758.5); dx = (h1 - 0.5) * q2; dy = (h2 - 0.5) * q2\",\n \"waves\": [],\n \"shapes\": []\n}"
